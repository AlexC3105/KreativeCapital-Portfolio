{
  "name": "@kreativecapital/contracts",
  "version": "2.0.0-dev",
  "private": true,
  "description": "KreativeCapital Solidity contracts and local Hardhat tooling (educational; local development only).",
  "license": "MIT",
  "scripts": {
    "compile": "hardhat compile && node scripts/export-artifacts.js",
    "test": "hardhat test",
    "node": "hardhat node --hostname 127.0.0.1",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "clean": "hardhat clean",
    "coverage": "hardhat coverage"
  },
  "dependencies": {
    "@openzeppelin/contracts": "4.9.6"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "2.1.2",
    "@nomicfoundation/hardhat-ethers": "3.1.4",
    "@nomicfoundation/hardhat-network-helpers": "1.1.2",
    "chai": "4.5.0",
    "ethers": "6.17.0",
    "hardhat": "2.30.0",
    "solidity-coverage": "0.8.17"
  }
}
